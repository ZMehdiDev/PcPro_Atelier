# Copier ce fichier en .env et l'adapter. Ne jamais committer .env.

# Database
POSTGRES_DB=atelier
POSTGRES_USER=atelier
# En production : un vrai mot de passe (openssl rand -base64 24), pas "atelier"
POSTGRES_PASSWORD=atelier
POSTGRES_PORT=5432

# Spring
SPRING_PORT=8080
# Vide = configuration de prod. "dev" = données de démo + Swagger.
SPRING_PROFILES_ACTIVE=

# Sécurité (obligatoire) : clé de signature des tokens, au moins 32 caractères.
# Générer avec : openssl rand -base64 48
APP_JWT_SECRET=

# Production (infra/docker-compose.prod.yml) : domaine public de l'appli, ex : atelier.pcpro-services.be
APP_DOMAIN=

# Cloudflare Tunnel (infra/docker-compose.tunnel.yml) : token du tunnel, donné par Cloudflare
# (Zero Trust > Networks > Tunnels). Secret : donne accès à l'appli comme si on était le serveur.
CLOUDFLARE_TUNNEL_TOKEN=

# Origines autorisées pour le front (séparées par des virgules)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger UI sur /swagger-ui (à laisser à false en production)
APP_SWAGGER_ENABLED=false

# Premier compte administrateur : créé (ou activé s'il existe sans mot de passe) au démarrage.
# À vider une fois connecté la première fois (le mot de passe ne doit pas rester dans ce fichier).
APP_BOOTSTRAP_ADMIN_LOGIN=zak
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Atelier : imprimé sur le bon de dépôt et dans les emails aux clients
APP_ATELIER_NOM=Pc Pro
APP_ATELIER_ADRESSE=
APP_ATELIER_TELEPHONE=
APP_ATELIER_EMAIL=
APP_ATELIER_HORAIRES=
# Garantie par défaut d'une réparation, en mois (0 = aucune)
APP_GARANTIE_MOIS=3
# Conditions imprimées en bas du bon de dépôt (facultatif)
APP_CONDITIONS_DEPOT=

# Emails aux clients (SMTP, ex : Brevo). Laisser SPRING_MAIL_HOST vide pour ne rien envoyer.
# Brevo : Paramètres > SMTP & API > SMTP. Le domaine de l'expéditeur doit être authentifié (SPF/DKIM).
# Brevo : SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Ex : Pc Pro <atelier@pcpro-services.be>
APP_MAIL_EXPEDITEUR=
